// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

func.func @vload_unpack_bad_ratio_same_type(
    %src: !pto.ptr<ui32, ub>,
    %off: index)
    -> !pto.vmi.vreg<64xui32> {
  // expected-error@+1 {{unpack requires result-to-source element bit-width ratio of 2:1 or 4:1}}
  %r = pto.vmi.vload %src[%off] {dist_mode = "unpack"}
      : !pto.ptr<ui32, ub> -> !pto.vmi.vreg<64xui32>
  return %r : !pto.vmi.vreg<64xui32>
}

// -----

func.func @vload_unpack_bad_ratio_reverse(
    %src: !pto.ptr<ui32, ub>,
    %off: index)
    -> !pto.vmi.vreg<64xui16> {
  // expected-error@+1 {{unpack requires result-to-source element bit-width ratio of 2:1 or 4:1}}
  %r = pto.vmi.vload %src[%off] {dist_mode = "unpack"}
      : !pto.ptr<ui32, ub> -> !pto.vmi.vreg<64xui16>
  return %r : !pto.vmi.vreg<64xui16>
}

