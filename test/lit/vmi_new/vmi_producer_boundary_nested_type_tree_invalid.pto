// RUN: pto-test-opt %s -split-input-file -allow-unregistered-dialect -pto-validate-vmi-ir -verify-diagnostics

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_struct(
      %x: !llvm.struct<(!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>)>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_ptr(
      %x: !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_tuple(
      %x: tuple<!pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_array(
      %x: !llvm.array<2 x !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_tensor_view(
      %x: !pto.tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_partition_view(
      %x: !pto.partition_tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @layout_in_deep(
      %x: !pto.ptr<!llvm.struct<(tuple<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>)>, ub>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @mask_in_struct(
      %x: !llvm.struct<(!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func @mask_in_ptr(
      %x: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  func.func private @nested_result() -> !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>
}

// -----

module {
  func.func @nested_op_result(%x: i32) {
    // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
    %r = builtin.unrealized_conversion_cast %x
        : i32 to !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: VMI producer boundary requires surface}}
  "test.region"() ({
  ^bb0(%x: !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>):
    "test.terminator"() : () -> ()
  }) : () -> ()
}
