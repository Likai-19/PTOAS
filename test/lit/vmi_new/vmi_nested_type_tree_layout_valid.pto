// RUN: pto-test-opt %s -split-input-file -pto-validate-vmi-layout-ir -verify-diagnostics

module {
  func.func @layout_in_struct(
      %x: !llvm.struct<(!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>)>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_ptr(
      %x: !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_tuple(
      %x: tuple<!pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_array(
      %x: !llvm.array<2 x !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_tensor_view(
      %x: !pto.tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_partition_view(
      %x: !pto.partition_tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module {
  func.func @layout_in_deep(
      %x: !pto.ptr<!llvm.struct<(tuple<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>)>, ub>,
      %mask: !pto.ptr<!pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>, ub>) {
    return
  }
}

// -----

module attributes {pto.plain_type = tuple<!pto.ptr<f32, ub>, !llvm.array<2 x f32>>} {
  func.func @plain_and_opaque(
      %plain: !pto.ptr<!llvm.struct<(tuple<f32>)>, ub>,
      %opaque: !llvm.struct<"opaque", opaque>) {
    return
  }
  func.func @recursive(
      %cycle: !llvm.struct<"cycle", (!pto.ptr<!llvm.struct<"cycle">, ub>, f32)>) {
    return
  }
}
