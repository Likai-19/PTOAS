// RUN: pto-test-opt %s -split-input-file -pto-validate-vmi-layout-ir -verify-diagnostics

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_struct(
      %x: !llvm.struct<(!pto.vmi.vreg<128xf32>)>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_ptr(
      %x: !pto.ptr<!pto.vmi.vreg<128xf32>, ub>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_tuple(
      %x: tuple<!pto.ptr<!pto.vmi.vreg<128xf32>, ub>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_array(
      %x: !llvm.array<2 x !pto.vmi.vreg<128xf32>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_tensor_view(
      %x: !pto.tensor_view<1x!pto.vmi.vreg<128xf32>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_partition_view(
      %x: !pto.partition_tensor_view<1x!pto.vmi.vreg<128xf32>>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_in_deep(
      %x: !pto.ptr<!llvm.struct<(tuple<!pto.vmi.vreg<128xf32>>)>, ub>) {
    return
  }
}

// -----

module {
  // expected-error@+1 {{VMI-PASS-INVARIANT: layout-assigned VMI IR requires}}
  func.func @surface_mask_in_ptr(
      %x: !pto.ptr<!pto.vmi.mask<128xpred>, ub>) {
    return
  }
}
