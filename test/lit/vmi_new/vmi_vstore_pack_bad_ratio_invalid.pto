// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

func.func @vstore_pack_bad_ratio_ui32_to_ui32(
    %v: !pto.vmi.vreg<64xui32>,
    %dst: !pto.ptr<ui32, ub>,
    %off: index) {
  // expected-error@+1 {{pack requires value-to-destination element bit-width ratio of 2:1 or 4:1}}
  pto.vmi.vstore %v, %dst[%off] {dist_mode = "pack"}
      : !pto.vmi.vreg<64xui32>, !pto.ptr<ui32, ub>
  return
}

// -----

func.func @vstore_pack_bad_ratio_ui8_to_ui32(
    %v: !pto.vmi.vreg<64xui8>,
    %dst: !pto.ptr<ui32, ub>,
    %off: index) {
  // expected-error@+1 {{pack requires value-to-destination element bit-width ratio of 2:1 or 4:1}}
  pto.vmi.vstore %v, %dst[%off] {dist_mode = "pack"}
      : !pto.vmi.vreg<64xui8>, !pto.ptr<ui32, ub>
  return
}

// -----

func.func @vstore_pack_bad_1to1_same_type(
    %v: !pto.vmi.vreg<64xui32>,
    %dst: !pto.ptr<ui32, ub>,
    %off: index) {
  // expected-error@+1 {{pack requires value-to-destination element bit-width ratio of 2:1 or 4:1}}
  pto.vmi.vstore %v, %dst[%off] {dist_mode = "pack"}
      : !pto.vmi.vreg<64xui32>, !pto.ptr<ui32, ub>
  return
}
