// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

// vstore pack: value bit-width must be >= destination bit-width.
// Valid ratios (value:dest): 1:1, 2:1, 4:1.
// Invalid: value narrower than dest (e.g. 1:2, 1:4).

func.func @vstore_pack_bad_ratio_reverse_8to32(
    %v: !pto.vmi.vreg<64xui8>,
    %dst: !pto.ptr<ui32, ub>,
    %off: index) {
  // expected-error@+1 {{pack requires value-to-destination element bit-width ratio of 1:1, 2:1, or 4:1}}
  pto.vmi.vstore %v, %dst[%off] {dist_mode = "pack"}
      : !pto.vmi.vreg<64xui8>, !pto.ptr<ui32, ub>
  return
}

// -----

func.func @vstore_pack_bad_ratio_reverse_16to32(
    %v: !pto.vmi.vreg<64xui16>,
    %dst: !pto.ptr<ui32, ub>,
    %off: index) {
  // expected-error@+1 {{pack requires value-to-destination element bit-width ratio of 1:1, 2:1, or 4:1}}
  pto.vmi.vstore %v, %dst[%off] {dist_mode = "pack"}
      : !pto.vmi.vreg<64xui16>, !pto.ptr<ui32, ub>
  return
}
