// RUN: pto-test-opt %s -split-input-file -pto-validate-vmi-ir -verify-diagnostics
// RUN: pto-test-opt %s -split-input-file -pto-validate-vmi-layout-ir -verify-diagnostics

// struct: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !llvm.struct<(!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>)>
} {}

// -----

// ptr: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>
} {}

// -----

// tuple: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = tuple<!pto.ptr<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, ub>>
} {}

// -----

// array: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !llvm.array<2 x !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>
} {}

// -----

// tensor_view: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !pto.tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>
} {}

// -----

// partition_view: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !pto.partition_tensor_view<1x!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>
} {}

// -----

// deep: a type attribute must not hide nested VMI.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = !pto.ptr<!llvm.struct<(tuple<!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>>)>, ub>
} {}

// -----

// Surface VMI is also forbidden in non-signature attributes.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = {nested = [!pto.ptr<!pto.vmi.mask<128xpred>, ub>]}
} {}

// -----

// Recursion through a function type inside a type attribute.
// expected-error@+1 {{VMI-PASS-INVARIANT: VMI type appears in a non-signature attribute}}
module attributes {
  pto.hidden_vmi_state = (!pto.ptr<!pto.vmi.vreg<128xf32>, ub>) -> ()
} {}
