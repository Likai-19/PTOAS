// The dump header is written with 32-bit stores, so the destination address
// must be 4-byte aligned. An i8 tile with an odd element offset gives a byte
// offset of 1: statically known, and it must be rejected at compile time.
// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_unaligned_dst(%out: !pto.ptr<i8, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i8, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c4, %c64], strides = [%c64, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?xi8>
    %part = pto.partition_view %view,
                offsets = [%c0, %c1], sizes = [%c4, %c32]
              : !pto.tensor_view<?x?xi8>
                -> !pto.partition_tensor_view<4x32xi8>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=i8, rows=4, cols=32, v_row=4, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<4x32xi8>)
    return
  }
}

// CHECK: expects a 4-byte aligned destination address
