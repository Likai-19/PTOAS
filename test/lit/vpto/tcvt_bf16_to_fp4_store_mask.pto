// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --enable-tile-op-expand --emit-vpto %s -o - | FileCheck %s

// Issue #1612, same class as the 4:1 store mask fix: a bf16 -> f4e2m1x2 chunk
// turns 128 source values into 64 packed pairs (one byte each).  Counting the
// store mask with the whole remaining row (a b8 predicate is 256 lanes wide)
// starves every chunk after the first, so the mask must count this chunk.
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tcvt_bf16_to_f4e2m1x2_8x64(%src: !pto.ptr<bf16, gm>, %dst: !pto.ptr<!pto.f4E2M1x2, gm>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %src_view = pto.make_tensor_view %src, shape = [%c8, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xbf16>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c8, %c64] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<8x64xbf16>
    %src_tile = pto.alloc_tile : !pto.tile_buf<vec, 8x64xbf16>
    %dst_tile = pto.alloc_tile : !pto.tile_buf<vec, 8x32x!pto.f4E2M1x2>
    pto.tload ins(%src_part : !pto.partition_tensor_view<8x64xbf16>) outs(%src_tile : !pto.tile_buf<vec, 8x64xbf16>)
    pto.tcvt ins(%src_tile {rmode = #pto<round_mode NONE>, satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 8x64xbf16>) outs(%dst_tile : !pto.tile_buf<vec, 8x32x!pto.f4E2M1x2>)
    return
  }
}

// A 64-lane b32 predicate counts the chunk, then the b8 store mask is built
// from that count (the old code fed the whole remainder straight to plt_b8).
// CHECK: pto.plt_b32
// CHECK: arith.subi
// CHECK: pto.plt_b8
// CHECK: pto.vsts
