// RUN: ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=pto-lower-tensor-dump %s -o %t.cpp 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_5d(%out: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c1, %c1, %c1, %c8, %c16], strides = [%c16, %c16, %c16, %c16, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?x?x?x?xf32>
    %part = pto.partition_view %view,
                offsets = [%c0, %c0, %c0, %c0, %c0], sizes = [%c1, %c1, %c1, %c8, %c16]
              : !pto.tensor_view<?x?x?x?x?xf32>
                -> !pto.partition_tensor_view<1x1x1x8x16xf32>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<1x1x1x8x16xf32>)
    return
  }
}

// CHECK-LABEL: IR Dump After LowerPTOTensorDump
// CHECK: pto.mte_ub_gm
// CHECK-SAME: nburst(
// CHECK-SAME: loop(
// CHECK-SAME: loop(
// CHECK-SAME: loop(
