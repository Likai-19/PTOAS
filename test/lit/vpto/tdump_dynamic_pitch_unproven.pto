// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_dynamic_pitch_unproven(%out: !pto.ptr<f32, gm>, %width: index, %pitch: index) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile valid_col = %width : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c4, %c16], strides = [%pitch, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view,
                offsets = [%c0, %c0], sizes = [%c4, %width]
              : !pto.tensor_view<?x?xf32>
                -> !pto.partition_tensor_view<4x?xf32>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<4x?xf32>)
    return
  }
}

// CHECK: expects destination row stride to equal its row width
