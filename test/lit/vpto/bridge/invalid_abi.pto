// RUN: pto-test-opt %s --verify-diagnostics
module {
  func.func @wrong_scalar(%fmt: !pto.ptr<i8, gm>, %value: i32) {
    // expected-error @+1 {{argument #1 has incompatible ABI type 'i32'}}
    pto.bridge.call #pto.bridge_entry<print_f32>(%fmt, %value : !pto.ptr<i8, gm>, i32)
    return
  }
}
