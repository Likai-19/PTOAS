// pto.print picks its entry by value type and by the format's conversion:
// f16/bf16 extend and f64 truncates to f32, narrow integers widen by
// signedness, and equal format strings share one interned addrspace(1)
// constant. Print entries have fixed prototypes, so they carry no spec.
//
// RUN: echo 'version: 1' > %t.policy
// RUN: echo 'families:' >> %t.policy
// RUN: echo '  print: { enabled_ops: [pto.print] }' >> %t.policy
// RUN: pto-test-opt %s "--pto-lower-bridge-ops=policy-path=%t.policy" | FileCheck %s
// RUN: pto-test-opt %s "--pto-lower-bridge-ops=policy-path=%t.policy" --vpto-resolve-bridge-instances --vpto-bridge-wrapper-gen | FileCheck %s --check-prefix=WRAPPER
//
// Print has no non-bridge VPTO path, so excluding it from the policy is an
// error rather than a silent fallback. It is enabled by the built-in default.
// RUN: echo 'version: 1' > %t.off
// RUN: echo 'families:' >> %t.off
// RUN: echo '  print: { enabled_ops: [] }' >> %t.off
// RUN: not pto-test-opt %s "--pto-lower-bridge-ops=policy-path=%t.off" 2>&1 | FileCheck %s --check-prefix=UNROUTED
// RUN: pto-test-opt %s --pto-lower-bridge-ops | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @prints(%f: f32, %h: f16, %d: f64, %i: i32, %u: i32, %w: i64) {
    pto.print ins("f32 = %f", %f : f32)
    pto.print ins("f16 = %f", %h : f16)
    pto.print ins("f64 = %f", %d : f64)
    pto.print ins("i32 = %d", %i : i32)
    pto.print ins("u32 = %x", %u : i32)
    pto.print ins("i64 = %lld", %w : i64)
    pto.print ins("f32 = %f", %f : f32)
    return
  }
}

// One global per distinct format string; "f32 = %f" is used twice.
// CHECK: llvm.mlir.global private constant @[[FMT0:pto_vpto_print_fmt_[0-9]+]](dense<[102, 51, 50, 32, 61, 32, 37, 102, 0]>{{.*}}{addr_space = 1 : i32}
// CHECK-LABEL: func.func @prints
// CHECK: %[[P0:.*]] = llvm.mlir.addressof @[[FMT0]] : !llvm.ptr<1>
// CHECK: pto.bridge.call <print_f32>(%[[P0]], %arg0 : !llvm.ptr<1>, f32)
// CHECK: %[[EXT:.*]] = llvm.fpext %arg1 : f16 to f32
// CHECK: pto.bridge.call <print_f32>(%{{.*}}, %[[EXT]] : !llvm.ptr<1>, f32)
// CHECK: %[[TRUNC:.*]] = llvm.fptrunc %arg2 : f64 to f32
// CHECK: pto.bridge.call <print_f32>(%{{.*}}, %[[TRUNC]] : !llvm.ptr<1>, f32)
// CHECK: %[[SEXT:.*]] = llvm.sext %arg3 : i32 to i64
// CHECK: pto.bridge.call <print_i64>(%{{.*}}, %[[SEXT]] : !llvm.ptr<1>, i64)
// CHECK: %[[ZEXT:.*]] = llvm.zext %arg4 : i32 to i64
// CHECK: pto.bridge.call <print_u64>(%{{.*}}, %[[ZEXT]] : !llvm.ptr<1>, i64)
// CHECK: pto.bridge.call <print_i64>(%{{.*}}, %arg5 : !llvm.ptr<1>, i64)
// CHECK: %[[P1:.*]] = llvm.mlir.addressof @[[FMT0]] : !llvm.ptr<1>
// CHECK: pto.bridge.call <print_f32>(%[[P1]], %arg0 : !llvm.ptr<1>, f32)
// CHECK-NOT: pto.print

// A print translation unit that forwards to cce::printf, and one instance per
// entry with no specialization.
// WRAPPER: renderer = "print"
// WRAPPER-SAME: ccelib/__ccelib.h
// WRAPPER-SAME: void pto_vpto_print_f32__0(__gm__ void *fmt, float value)
// WRAPPER-SAME: cce::printf((__gm__ const char *)fmt, value);
// WRAPPER-SAME: void pto_vpto_print_u64__2(__gm__ void *fmt, uint64_t value)
// WRAPPER-SAME: cce::printf((__gm__ const char *)fmt, (long long)value);
// WRAPPER-DAG: pto.bridge.instance @pto_vpto_print_f32__0 <print_f32> core <vector>{{$}}
// WRAPPER-DAG: pto.bridge.instance @pto_vpto_print_i64__1 <print_i64> core <vector>{{$}}
// WRAPPER-DAG: pto.bridge.instance @pto_vpto_print_u64__2 <print_u64> core <vector>{{$}}

// UNROUTED: the route policy excludes pto.print, which has no non-bridge VPTO lowering
