// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @printing(%value: i32) attributes {pto.entry} {
    pto.print ins("%d", %value : i32)
    return
  }
  func.func @copies(%out: !llvm.ptr<1>, %value: i32) attributes {pto.entry} {
    llvm.store %value, %out : i32, !llvm.ptr<1>
    return
  }
}

// CHECK: define void @printing_mix_aiv(i32 %0, ptr addrspace(1) %.DTData)
// CHECK: define void @copies_mix_aiv(ptr addrspace(1) %0, i32 %1, ptr addrspace(1) %.DTData)
// CHECK: store i32 %1, ptr addrspace(1) %0
