// RUN: pto-test-opt %s --verify-diagnostics
module {
  func.func @init_as_call(%storage: !pto.ptr<i8, ub>, %local: i32) {
    // expected-error @+1 {{requires a registered non-object entry}}
    pto.bridge.call #pto.bridge_entry<pipe_init>(%storage, %local : !pto.ptr<i8, ub>, i32)
    return
  }
}
