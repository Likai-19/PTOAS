// RUN: pto-test-opt %s --pto-lower-bridge-ops --vpto-resolve-bridge-instances --vpto-bridge-wrapper-gen | FileCheck %s

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @v2c() {
    %local = arith.constant 4096 : i32
    %pipe = pto.initialize_l2l_pipe {dir_mask = 2, slot_size = 1024, slot_num = 8, flag_base = 0}(%local : i32) -> !pto.pipe
    return
  }
}

// CHECK: pto::Direction::DIR_V2C
// CHECK-SAME: new (storage) Pipe(nullptr, 0, localBuffer);
