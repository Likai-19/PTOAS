// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto --emit-pto-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_dst_shape_mismatch_5d(%out: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %c8 = arith.constant 8 : index
    %c64 = arith.constant 64 : index
    %c256 = arith.constant 256 : index
    %c1024 = arith.constant 1024 : index
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c1, %c1, %c1, %c4, %c16], strides = [%c1024, %c256, %c64, %c16, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?x?x?x?xf32>
    %part = pto.partition_view %view,
                offsets = [%c0, %c0, %c0, %c0, %c0], sizes = [%c1, %c1, %c1, %c4, %c8]
              : !pto.tensor_view<?x?x?x?x?xf32>
                -> !pto.partition_tensor_view<1x1x1x4x8xf32>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<1x1x1x4x8xf32>)
    return
  }
}

// CHECK: expects dst shape[4] (8) to match src valid_shape[1] (16)
