// issue #1606 keeps A2/A3 without the bf16 form: only the A5 clause lists it.
// RUN: not ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @tcmps_bf16_a3(
      %src: !pto.tile_buf<vec, 8x32xbf16>, %scalar: bf16,
      %dst: !pto.tile_buf<vec, 8x32xi8>) {
    pto.tcmps ins(%src, %scalar {cmpMode = #pto<cmp lt>} : !pto.tile_buf<vec, 8x32xbf16>, bf16)
              outs(%dst : !pto.tile_buf<vec, 8x32xi8>)
    return
  }
}

// CHECK: error: 'pto.tcmps' op expects A2/A3 tcmps input element type to be i16/i32/f16/f32
