// pto.tdump copies one destination row per valid tile row using the tile's row
// pitch, so a destination that merely has the same element count is still
// wrong: 8x8 and a 4x16 valid region are both 64 elements. The verifier must
// compare dimensions, not counts.
// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_dst_shape_mismatch(%out: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c8, %c8], strides = [%c8, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view,
                offsets = [%c0, %c0], sizes = [%c8, %c8]
              : !pto.tensor_view<?x?xf32>
                -> !pto.partition_tensor_view<8x8xf32>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=16, v_row=4, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<8x8xf32>)
    return
  }
}

// CHECK: expects dst shape[0] (8) to match src valid_shape[0] (4)
