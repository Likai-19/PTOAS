// RUN: ptoas --pto-arch=a3 --pto-backend=emitc %s -o %t.cpp
// RUN: %python %S/../../npu_validation/scripts/generate_testcase.py --input %t.cpp --output-root %t.gen --testcase assert_probe --soc-version Ascend910
// RUN: cat %t.gen/*/assert_probe/CMakeLists.txt | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  func.func @assert_probe(%out: !pto.ptr<i32, gm>, %condition: i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.assert %condition {message = "check failed"} : i1
    return
  }
}

// CHECK: --cce-enable-print
// CHECK: -DPTOAS_ENABLE_CCE_PRINT=1
