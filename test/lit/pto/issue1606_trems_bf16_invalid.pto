// issue #1606: the pinned docs/isa/TREMS.md does not list bf16 for A5 (only
// the C++ header's sizeof(T) gate admits it), so a bf16 trems is rejected.
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @trems_bf16(
      %src: !pto.tile_buf<vec, 8x32xbf16>, %scalar: bf16,
      %tmp: !pto.tile_buf<vec, 8x32xbf16>, %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.trems ins(%src, %scalar, %tmp : !pto.tile_buf<vec, 8x32xbf16>, bf16, !pto.tile_buf<vec, 8x32xbf16>)
              outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
}

// CHECK: error: 'pto.trems' op expects A5 trems element type to be i32/i16/f16/f32
