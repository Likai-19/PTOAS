// RUN: ptoas --pto-arch=a5 --pto-backend=emitc %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @print_escaped(%value: f32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.print ins("a\\\"b\\\\c %f", %value : f32)
    return
  }
  func.func @print_control_chars(%value: f32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.print ins("line\0D\n\tend", %value : f32)
    return
  }
}

// CHECK: cce::printf("a\\\"b\\\\c %f",
// CHECK: cce::printf("line\015\n\tend",
