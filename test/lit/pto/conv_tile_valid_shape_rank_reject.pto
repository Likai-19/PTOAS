// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

// The valid shape describes the same tensor as the declared shape, so it
// must carry the same rank.

module attributes {"pto.target_arch" = "a5"} {
  func.func @valid_rank_mismatch() {
    %t = pto.alloc_tile : !pto.conv_tile_buf<mat, 1x1x3x8x16xf16, buffer_size=384 : i64, layout=#pto.conv_layout<nc1hwc0>, valid_shape=1x3x8x16>
    return
  }
}

// CHECK: conv_tile valid_shape must have the same rank as shape (5), got 4
