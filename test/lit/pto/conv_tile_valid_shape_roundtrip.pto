// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck --check-prefix=EMITC %s

// valid_shape is the logical tensor the tile holds (runtime ConvTile
// ValidShape_): the declared shape stays the storage capacity, only the
// non-blocked dims may shrink, and valid == declared is stored as the
// canonical "unspecified" form.

module attributes {"pto.target_arch" = "a5"} {
  func.func @with_valid_shape() {
    // W shrunk 8 -> 5; the blocked C0 tail (16) keeps the declared extent.
    %t = pto.alloc_tile : !pto.conv_tile_buf<mat, 1x1x3x8x16xf16, buffer_size=384 : i64, layout=#pto.conv_layout<nc1hwc0>, valid_shape=1x1x3x5x16>
    return
  }

  func.func @fractal_z_valid_n() {
    // rank-5 FRACTAL_Z [C1,H,W,N,C0]: N shrunk 32 -> 16, C0 tail kept.
    %t = pto.alloc_tile : !pto.conv_tile_buf<mat, 1x3x4x32x16xf16, buffer_size=6144 : i64, layout=#pto.conv_layout<fractal_z>, valid_shape=1x3x4x16x16>
    return
  }

  func.func @canonical_equal_valid() {
    // valid_shape equal to shape parses fine and prints back without the
    // valid_shape key: one representation per logical type.
    %t = pto.alloc_tile : !pto.conv_tile_buf<mat, 1x1x3x8x16xf16, buffer_size=384 : i64, layout=#pto.conv_layout<nc1hwc0>, valid_shape=1x1x3x8x16>
    return
  }
}

// CHECK-LABEL: func.func @with_valid_shape
// CHECK: conv_tile_buf<mat, 1x1x3x8x16xf16, buffer_size=384 : i64, layout=#pto.conv_layout<nc1hwc0>, valid_shape=1x1x3x5x16>

// CHECK-LABEL: func.func @fractal_z_valid_n
// CHECK: conv_tile_buf<mat, 1x3x4x32x16xf16, buffer_size=6144 : i64, layout=#pto.conv_layout<fractal_z>, valid_shape=1x3x4x16x16>

// CHECK-LABEL: func.func @canonical_equal_valid
// CHECK: conv_tile_buf<mat, 1x1x3x8x16xf16, buffer_size=384 : i64, layout=#pto.conv_layout<nc1hwc0>>
// CHECK-NOT: valid_shape=1x1x3x8x16

// EMITC: ConvTileShape<1, 1, 3, 8, 16>, pto::ConvTileShape<1, 1, 3, 5, 16>
// EMITC: ConvTileShape<1, 3, 4, 32, 16>, pto::ConvTileShape<1, 3, 4, 16, 16>
// EMITC-NOT: ConvTileShape<1, 1, 3, 8, 16>, pto::ConvTileShape<1, 1, 3, 8, 16>
