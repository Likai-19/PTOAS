// issue #1606: the pto-isa bitwise clauses are integral-only (docs/isa/TAND.md,
// TOR.md, TANDS.md, TORS.md, TXORS.md), so a float tile element is rejected on
// both architectures (the C++ headers' sizeof(T) static_assert is looser).
// RUN: not ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s --check-prefix=A3
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s --check-prefix=A5

module {
  func.func private @tand_f16(
      %a: !pto.tile_buf<vec, 8x32xf16>, %b: !pto.tile_buf<vec, 8x32xf16>,
      %dst: !pto.tile_buf<vec, 8x32xf16>) {
    pto.tand ins(%a, %b : !pto.tile_buf<vec, 8x32xf16>, !pto.tile_buf<vec, 8x32xf16>)
              outs(%dst : !pto.tile_buf<vec, 8x32xf16>)
    return
  }
}

// A3: error: 'pto.tand' op expects A2/A3 tand src0, src1, and dst element type to be a 1/2/4-byte integer
// A5: error: 'pto.tand' op expects A5 tand src0, src1, and dst element type to be a 1/2/4-byte integer
