// issue #1606: the binary txor clause does not list a float form, so A5 must
// keep rejecting it even though the scalar txors form accepts floats.
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @txor_f32(
      %a: !pto.tile_buf<vec, 8x32xf32>, %b: !pto.tile_buf<vec, 8x32xf32>,
      %dst: !pto.tile_buf<vec, 8x32xf32>) {
    pto.txor ins(%a, %b : !pto.tile_buf<vec, 8x32xf32>, !pto.tile_buf<vec, 8x32xf32>)
             outs(%dst : !pto.tile_buf<vec, 8x32xf32>)
    return
  }
}

// CHECK: error: 'pto.txor' op expects A5 txor src0, src1, and dst element type to be i8/i16/i32
