// issue #1606: the bitwise scalar ops are integral-only, so a float scalar is
// rejected by the IntScalarType operand constraint.
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @tands_f16(
      %src: !pto.tile_buf<vec, 8x32xf16>, %scalar: f16,
      %dst: !pto.tile_buf<vec, 8x32xf16>) {
    pto.tands ins(%src, %scalar : !pto.tile_buf<vec, 8x32xf16>, f16)
              outs(%dst : !pto.tile_buf<vec, 8x32xf16>)
    return
  }
}

// CHECK: operand #1 must be integer scalar, but got 'f16'
