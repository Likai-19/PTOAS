// issue #1606: the integer TABS forms are A5-only; A2/A3 TABS is float-only.
// RUN: not ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @tabs_i16_a3(
      %src: !pto.tile_buf<vec, 8x32xi16>, %dst: !pto.tile_buf<vec, 8x32xi16>) {
    pto.tabs ins(%src : !pto.tile_buf<vec, 8x32xi16>) outs(%dst : !pto.tile_buf<vec, 8x32xi16>)
    return
  }
}

// CHECK: error: 'pto.tabs' op expects A2/A3 element type to be f16 or f32
