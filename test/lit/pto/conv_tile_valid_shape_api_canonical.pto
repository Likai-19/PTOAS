// RUN: python3 %S/Inputs/check_conv_tile_valid_shape_api_canonical.py | FileCheck %s

// The API path must agree with the textual parser: passing valid_shape equal
// to shape builds the canonical "unspecified" type instead of returning None.

// CHECK: plain: !pto.conv_tile_buf<mat, 1x1x3x4x16xf16, buffer_size=192 : i64, layout=#pto.conv_layout<nc1hwc0>>
// CHECK: equal: !pto.conv_tile_buf<mat, 1x1x3x4x16xf16, buffer_size=192 : i64, layout=#pto.conv_layout<nc1hwc0>>
// CHECK: shrunk: !pto.conv_tile_buf<mat, 1x1x3x4x16xf16, buffer_size=192 : i64, layout=#pto.conv_layout<nc1hwc0>, valid_shape=1x1x2x4x16>
// CHECK: API-CANONICAL-OK
// CHECK-NOT: valid_shape=1x1x3x4x16
