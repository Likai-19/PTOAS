// case: vmi_new/pack-unpack-roundtrip-f8e4m3
// Probe same-type (f8e4m3) pack/unpack round-trip on the 4:1 carrier path.
//   vload {dist_mode="unpack"} reads N f8 elements and expands them into the
//   even sub-lanes of a 4N-lane vreg (UNPK4).  vstore {dist_mode="pack"} then
//   compacts the active sub-lanes back to N contiguous f8 bytes (PK4_B32).
// Golden == src because the round-trip only reorganises bits, no rounding.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @pack_unpack_roundtrip_f8e4m3_kernel(%src_gm: !pto.ptr<f8E4M3FN, gm>,
                                                  %dst_gm: !pto.ptr<f8E4M3FN, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64
    %c16384_i64 = arith.constant 16384 : i64

    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f8E4M3FN, ub>
    %ub_dst = pto.castptr %c16384_i64 : i64 -> !pto.ptr<f8E4M3FN, ub>

    // Load 256 x f8 = 256 bytes from GM to UB
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f8E4M3FN, gm>, !pto.ptr<f8E4M3FN, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    pto.vecscope {
      // Unpack: read N f8 elements, expand into 1024-lane vreg (UNPK4).
      %x = pto.vmi.vload %ub_src[%c0] {dist_mode = "unpack"}
          : !pto.ptr<f8E4M3FN, ub> -> !pto.vmi.vreg<1024xf8E4M3FN>
      // Pack: compact active sub-lanes back to N contiguous f8 bytes (PK4_B32).
      pto.vmi.vstore %x, %ub_dst[%c0] {dist_mode = "pack"}
          : !pto.vmi.vreg<1024xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f8E4M3FN, ub>, !pto.ptr<f8E4M3FN, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
