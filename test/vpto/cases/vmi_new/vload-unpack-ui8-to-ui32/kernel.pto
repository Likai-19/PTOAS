module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vload_unpack_ui8_to_ui32_kernel(%src_gm: !pto.ptr<ui8, gm>,
                             %dst_gm: !pto.ptr<ui32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c8192_i64 = arith.constant 8192 : i64

    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<ui8, ub>
    %ub_dst = pto.castptr %c8192_i64 : i64 -> !pto.ptr<ui32, ub>

    // Load 256 x ui8 = 256 bytes from GM to UB
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<ui8, gm>, !pto.ptr<ui8, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    pto.vecscope {
      %x = pto.vmi.vload %ub_src[%c0] {dist_mode = "unpack"}
          : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<256xui32>
      pto.vmi.vstore %x, %ub_dst[%c0]
          : !pto.vmi.vreg<256xui32>, !pto.ptr<ui32, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<ui32, ub>, !pto.ptr<ui32, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
